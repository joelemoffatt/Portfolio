---
import skills from '../data/skills.json';
---

<section id="skills">
	<div class="container">
		<span class="section-label">// capabilities</span>
		<h2>Skills</h2>
		<div class="card">
			{skills.map((group) => (
				<div class="group">
					<h3>{group.group}</h3>
					<ul>
						{group.items.map((item) => (
							<li>{item}</li>
						))}
					</ul>
				</div>
			))}
		</div>
	</div>
</section>

<style>
	section {
		border-bottom: 1px solid var(--color-border);
		padding-top: 3rem;
		padding-bottom: 3rem;
	}

	h2 {
		margin-bottom: 1.5rem;
		color: #D2E5EF
	}

	.card {
		background: #D2E5EF;
		border-radius: var(--radius);
		display: grid;
		grid-template-columns: repeat(3, 1fr);
		width: 100%;
		overflow: hidden;
	}

	@media (max-width: 600px) {
		.card { grid-template-columns: 1fr; }
	}

	.group { padding: 1.75rem; }

	h3 {
		font-size: 0.8rem;
		font-weight: 700;
		font-family: var(--font-display);
		text-transform: uppercase;
		letter-spacing: 0.08em;
		color: #0E172A;
		margin-bottom: 1rem;
	}

	ul {
		list-style: none;
		margin: 0;
		padding: 0;
		display: flex;
		flex-direction: column;
	}

	li {
		font-size: 0.9375rem;
		color: #475569;
		padding: 0.3rem 0 0.3rem 1rem;
		position: relative;
	}

	li::before {
		content: '';
		position: absolute;
		left: 0;
		top: 50%;
		transform: translateY(-50%);
		width: 5px;
		height: 5px;
		background: #0066CC;
	}
</style>

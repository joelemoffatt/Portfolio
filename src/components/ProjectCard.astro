---
interface RepoEntry { label: string; url: string; }

interface Props {
	index: number;
	slug: string;
	title: string;
	description: string;
	stack: string[];
	repo?: string | RepoEntry[];
	live?: string;
}

const { index, slug, title, description, stack, repo, live } = Astro.props;
const num = String(index).padStart(2, '0');
const repoHref = Array.isArray(repo) ? repo[0]?.url : repo;
---

<article class="card">
	<div class="card-top">
		<span class="num">{num}</span>
		<div class="card-links">
			{repoHref && (
				<a href={repoHref} target="_blank" rel="noopener noreferrer" aria-label="Github Repo">
					<svg viewBox="0 0 16 16" aria-hidden="true" width="15" height="15">
						<path fill="currentColor" d="M8 0C3.58 0 0 3.58 0 8c0 3.54 2.29 6.53 5.47 7.59.4.07.55-.17.55-.38 0-.19-.01-.82-.01-1.49-2.01.37-2.53-.49-2.69-.94-.09-.23-.48-.94-.82-1.13-.28-.15-.68-.52-.01-.53.63-.01 1.08.58 1.23.82.72 1.21 1.87.87 2.33.66.07-.52.28-.87.51-1.07-1.78-.2-3.64-.89-3.64-3.95 0-.87.31-1.59.82-2.15-.08-.2-.36-1.02.08-2.12 0 0 .67-.21 2.2.82.64-.18 1.32-.27 2-.27.68 0 1.36.09 2 .27 1.53-1.04 2.2-.82 2.2-.82.44 1.1.16 1.92.08 2.12.51.56.82 1.27.82 2.15 0 3.07-1.87 3.75-3.65 3.95.29.25.54.73.54 1.48 0 1.07-.01 1.93-.01 2.2 0 .21.15.46.55.38A8.012 8.012 0 0 0 16 8c0-4.42-3.58-8-8-8z"/>
					</svg>
				</a>
			)}
			{live && (
				<a href={live} target="_blank" rel="noopener noreferrer" aria-label="Live site">
					<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" width="20" height="20">
						<path stroke-linecap="round" stroke-linejoin="round" d="M12 21a9.004 9.004 0 008.716-6.747M12 21a9.004 9.004 0 01-8.716-6.747M12 21c2.485 0 4.5-4.03 4.5-9S14.485 3 12 3m0 18c-2.485 0-4.5-4.03-4.5-9S9.515 3 12 3m0 0a8.997 8.997 0 017.843 4.582M12 3a8.997 8.997 0 00-7.843 4.582m15.686 0A11.953 11.953 0 0112 10.5c-2.998 0-5.74-1.1-7.843-2.918m15.686 0A8.959 8.959 0 0121 12c0 .778-.099 1.533-.284 2.253m0 0A17.919 17.919 0 0112 16.5c-3.162 0-6.133-.815-8.716-2.247m0 0A9.015 9.015 0 013 12c0-1.605.42-3.113 1.157-4.418"/>
					</svg>
				</a>
			)}
		</div>
	</div>
	<div class="card-body">
		<h3>{title}</h3>
		<p>{description}</p>
	</div>
	<div class="card-footer">
		<ul class="stack">
			{stack.map((tech) => <li>{tech}</li>)}
		</ul>
		<a href={`/projects/${slug}`} class="detail-link">
			Read more
			<svg viewBox="0 0 16 16" aria-hidden="true" width="11" height="11">
				<path fill="currentColor" d="M1 8a.5.5 0 0 1 .5-.5h11.793l-3.147-3.146a.5.5 0 0 1 .708-.708l4 4a.5.5 0 0 1 0 .708l-4 4a.5.5 0 0 1-.708-.708L13.293 8.5H1.5A.5.5 0 0 1 1 8z"/>
			</svg>
		</a>
	</div>
</article>

<style>
	.card {
		display: flex;
		flex-direction: column;
		background: #D2E5EF;
		border: 1px solid rgba(0, 102, 204, 0);
		border-radius: var(--radius);
		padding: 1.5rem;
		transition: border-color 0.2s ease, box-shadow 0.2s ease, transform 0.2s var(--ease-out);
	}

	.card:hover {
		border-color: #0066CC;
		box-shadow: 0 8px 32px rgba(0, 102, 204, 0.12), 0 2px 8px rgba(0, 0, 0, 0.04);
		transform: translateY(-2px);
	}

	.card-top {
		display: flex;
		align-items: center;
		justify-content: space-between;
		margin-bottom: 1.25rem;
	}

	.num {
		font-family: var(--font-mono);
		font-size: 0.7rem;
		color: #94A3B8;
		letter-spacing: 0.05em;
	}

	.card-links {
		display: flex;
		gap: 0.5rem;
	}

	.card-links a {
		display: flex;
		align-items: center;
		justify-content: center;
		width: 28px;
		height: 28px;
		border-radius: 4px;
		color: #475569;
		background: #dceef8;
		border: 1px solid rgba(0, 102, 204, 0.2);
		transition: color 0.15s ease, border-color 0.15s ease, background 0.15s ease;
		text-decoration: none;
	}

	.card-links a:hover {
		color: #0066CC;
		border-color: #0066CC;
		background: rgba(0, 102, 204, 0.1);
		text-decoration: none;
	}

	.card-body {
		flex: 1;
	}

	h3 {
		font-size: 1.15rem;
		margin-bottom: 0.5rem;
		color: #0E172A;
	}

	p {
		color: #475569;
		font-size: 0.9375rem;
		margin-bottom: 0;
		line-height: 1.65;
	}

	.card-footer {
		display: flex;
		flex-direction: column;
		align-items: flex-start;
		gap: 0.75rem;
		margin-top: 1.25rem;
		padding-top: 1.25rem;
		border-top: 1px solid rgba(0, 102, 204, 0.14);
	}

	.stack {
		list-style: none;
		margin: 0;
		padding: 0;
		display: flex;
		flex-wrap: wrap;
		gap: 0.375rem;
	}

	.stack li {
		font-family: var(--font-mono);
		font-size: 0.7rem;
		color: #475569;
		background: #dceef8;
		border: 1px solid rgba(0, 102, 204, 0.2);
		border-radius: 3px;
		padding: 0.15rem 0.5rem;
	}

	.detail-link {
		display: inline-flex;
		align-items: center;
		gap: 0.3rem;
		font-family: var(--font-mono);
		font-size: 0.7rem;
		color: #0066CC;
		text-decoration: none;
		white-space: nowrap;
		flex-shrink: 0;
		transition: gap 0.15s ease;
	}

	.detail-link:hover {
		gap: 0.5rem;
		text-decoration: none;
	}
</style>

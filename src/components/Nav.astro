---
import { SITE_TITLE } from '../consts';
---

<header>
	<nav class="container">
		<a href="/" class="brand">{SITE_TITLE}</a>
		<ul>
			<li><a href="#projects">Projects</a></li>
			<li><a href="#skills">Skills</a></li>
			<li><a href="#contact">Contact</a></li>
		</ul>
	</nav>
</header>

<style>
	header {
		position: sticky;
		top: 0;
		z-index: 100;
		background: rgba(210, 229, 239, 0.92);
		backdrop-filter: blur(12px);
		-webkit-backdrop-filter: blur(12px);
		border-bottom: 1px solid rgba(180, 210, 228, 0.6);
	}

	nav {
		display: flex;
		align-items: center;
		justify-content: space-between;
		height: 3.25rem;
	}

	.brand {
		font-family: var(--font-display);
		font-weight: 400;
		font-size: 1.1rem;
		color: var(--color-text);
		text-decoration: none;
		letter-spacing: -0.01em;
	}

	.brand:hover {
		text-decoration: none;
		color: var(--color-accent);
	}

	ul {
		list-style: none;
		margin: 0;
		padding: 0;
		display: flex;
		gap: 0.25rem;
	}

	ul a {
		font-family: var(--font-mono);
		font-size: 0.75rem;
		color: var(--color-text-muted);
		text-decoration: none;
		padding: 0.35rem 0.75rem;
		border-radius: var(--radius);
		transition: color 0.15s ease, background 0.15s ease;
	}

	ul a:hover {
		color: var(--color-accent);
		background: var(--color-accent-dim);
		text-decoration: none;
	}

	@media (max-width: 480px) {
		ul {
			gap: 0;
		}
		ul a {
			padding: 0.35rem 0.5rem;
		}
	}
</style>

<script>
	let cancelled = false;

	const cancelScroll = () => { cancelled = true; };
	window.addEventListener('wheel',     cancelScroll, { passive: true });
	window.addEventListener('touchmove', cancelScroll, { passive: true });
	window.addEventListener('keydown',   (e) => {
		if (['ArrowUp','ArrowDown','PageUp','PageDown','Home','End',' '].includes(e.key)) cancelScroll();
	});

	document.querySelectorAll<HTMLAnchorElement>('nav a[href^="#"]').forEach(link => {
		link.addEventListener('click', e => {
			const id = link.getAttribute('href')!.slice(1);
			const target = document.getElementById(id);
			if (!target) return;
			e.preventDefault();
			cancelled = false;
			const start = window.scrollY;
			const end = target.getBoundingClientRect().top + window.scrollY;
			const duration = 2000;
			let startTime: number | null = null;
			const ease = (t: number) => t < 0.5 ? 2 * t * t : -1 + (4 - 2 * t) * t;
			const step = (now: number) => {
				if (cancelled) return;
				if (!startTime) startTime = now;
				const elapsed = Math.min((now - startTime) / duration, 1);
				window.scrollTo({ top: start + (end - start) * ease(elapsed), behavior: 'instant' });
				if (elapsed < 1) requestAnimationFrame(step);
			};
			requestAnimationFrame(step);
		});
	});
</script>

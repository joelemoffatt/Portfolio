---
import profile from '../data/profile.json';
---

<section class="hero">
	<div class="container">
		<span class="greeting">// {profile.tagline.toLowerCase()}</span>
		<h1>{profile.name}</h1>
		<p class="bio">{profile.bio}</p>
	</div>
</section>

<style>
	.hero {
		min-height: calc(90svh - 3.25rem);
		padding: 0 1.5rem;
		position: sticky;
		top: 3.25rem;
		z-index: 0;
		display: flex;
		align-items: flex-start;
		padding-top: 20svh;
		background: #d2e5ef;
	}

	.container {
		position: relative;
	}

	/* Staggered entrance */
	.greeting {
		animation: fadeUp 0.6s var(--ease-out) both;
		animation-delay: 0.05s;
	}
	h1 {
		animation: fadeUp 0.7s var(--ease-out) both;
		animation-delay: 0.15s;
	}
	.bio {
		animation: fadeUp 0.7s var(--ease-out) both;
		animation-delay: 0.28s;
	}

	.greeting {
		display: block;
		font-family: var(--font-mono);
		font-size: 1.4rem;
		color: var(--color-accent);
		letter-spacing: 0.01em;
	}

	h1 {
		font-size: clamp(3.5rem, 9vw, 6rem);
		letter-spacing: -0.03em;
		margin-bottom: 0;
	}

	.bio {
		max-width: 640px;
		color: var(--color-text-muted);
		font-size: 1.25rem;
		margin-bottom: 0;
		line-height: 1.75;
	}

	@media (max-width: 600px) {
		.hero {
			padding: 0 1.25rem 6rem;
			padding-top: max(4rem, 10svh);
			align-items: flex-start;
		}
	}
</style>

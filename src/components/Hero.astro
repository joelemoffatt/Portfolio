---
import profile from '../data/profile.json';
---

<section class="hero">
	<div class="container">
		<span class="greeting">// {profile.tagline.toLowerCase()}</span>
		<h1>{profile.name}</h1>
		<p class="bio">{profile.bio}</p>
		<div class="cta-group">
			<a href="#projects" class="btn-primary">View projects</a>
			<a href="#contact" class="btn-secondary">Get in touch</a>
		</div>
		<div class="meta">
			<span class="meta-item">
				<span class="dot"></span>
				Available for work
			</span>
			{profile.location && (
				<>
					<span class="meta-divider">—</span>
					<span class="meta-item">Based in {profile.location}</span>
				</>
			)}
		</div>
	</div>
</section>

<style>
	.hero {
		padding: 7rem 1.5rem 5.5rem;
		border-bottom: 1px solid var(--color-border);
		position: relative;
		overflow: hidden;
	}

	/* Radial vignette to frame the hero */
	.hero::before {
		content: '';
		position: absolute;
		inset: 0;
		background: radial-gradient(ellipse 80% 60% at 50% 0%, rgba(0, 102, 204, 0.04) 0%, transparent 70%);
		pointer-events: none;
	}

	.container {
		position: relative;
	}

	/* Staggered entrance */
	.greeting {
		animation: fadeUp 0.6s var(--ease-out) both;
		animation-delay: 0.05s;
	}
	h1 {
		animation: fadeUp 0.7s var(--ease-out) both;
		animation-delay: 0.15s;
	}
	.bio {
		animation: fadeUp 0.7s var(--ease-out) both;
		animation-delay: 0.28s;
	}
	.cta-group {
		animation: fadeUp 0.7s var(--ease-out) both;
		animation-delay: 0.4s;
	}
	.meta {
		animation: fadeUp 0.7s var(--ease-out) both;
		animation-delay: 0.52s;
	}

	.greeting {
		display: block;
		font-family: var(--font-mono);
		font-size: 0.8125rem;
		color: var(--color-accent);
		margin-bottom: 1rem;
		letter-spacing: 0.01em;
	}

	h1 {
		margin-bottom: 1.25rem;
		letter-spacing: -0.02em;
	}

	.bio {
		max-width: 520px;
		color: var(--color-text-muted);
		font-size: 1.0625rem;
		margin-bottom: 2.25rem;
		line-height: 1.75;
	}

	.cta-group {
		display: flex;
		gap: 0.75rem;
		flex-wrap: wrap;
		margin-bottom: 2.5rem;
	}

	.btn-primary,
	.btn-secondary {
		display: inline-block;
		padding: 0.6rem 1.4rem;
		border-radius: var(--radius);
		font-size: 0.9rem;
		font-weight: 500;
		text-decoration: none;
		transition: background 0.18s ease, color 0.18s ease, border-color 0.18s ease, box-shadow 0.18s ease;
		font-family: var(--font-body);
	}

	.btn-primary {
		background: var(--color-accent);
		color: #fff;
		border: 1.5px solid var(--color-accent);
	}

	.btn-primary:hover {
		background: var(--color-accent-hover);
		border-color: var(--color-accent-hover);
		box-shadow: 0 4px 16px rgba(0, 102, 204, 0.25);
		text-decoration: none;
	}

	.btn-secondary {
		background: var(--color-surface);
		color: var(--color-text);
		border: 1.5px solid var(--color-border);
	}

	.btn-secondary:hover {
		border-color: var(--color-border-strong);
		text-decoration: none;
	}

	/* Availability indicator */
	.meta {
		display: flex;
		align-items: center;
		gap: 0.6rem;
		font-family: var(--font-mono);
		font-size: 0.7rem;
		color: var(--color-text-subtle);
	}

	.meta-item {
		display: flex;
		align-items: center;
		gap: 0.4rem;
	}

	.dot {
		width: 6px;
		height: 6px;
		border-radius: 50%;
		background: #22c55e;
		box-shadow: 0 0 0 2px rgba(34, 197, 94, 0.25);
		animation: pulse 2.5s ease infinite;
	}

	@keyframes pulse {
		0%, 100% { box-shadow: 0 0 0 2px rgba(34, 197, 94, 0.25); }
		50% { box-shadow: 0 0 0 5px rgba(34, 197, 94, 0.08); }
	}

	.meta-divider {
		color: var(--color-border-strong);
	}

	@media (max-width: 600px) {
		.hero {
			padding: 5rem 1.25rem 3.5rem;
		}
	}
</style>

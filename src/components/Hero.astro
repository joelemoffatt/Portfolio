---
import profile from '../data/profile.json';
---

<section class="hero">
	<div class="container">
		<span class="greeting">// {profile.tagline.toLowerCase()}</span>
		<h1>{profile.name}</h1>
		<p class="bio">{profile.bio}</p>
	</div>
	<svg class="wave" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 900 200" preserveAspectRatio="none" aria-hidden="true">
		<path d="M0 38L21.5 47.7C43 57.3 86 76.7 128.8 68.7C171.7 60.7 214.3 25.3 257.2 24.5C300 23.7 343 57.3 385.8 77.5C428.7 97.7 471.3 104.3 514.2 93.3C557 82.3 600 53.7 642.8 48.5C685.7 43.3 728.3 61.7 771.2 57.5C814 53.3 857 26.7 878.5 13.3L900 0L900 200L0 200Z" fill="#0066CC"/>
	</svg>
</section>

<style>
	.hero {
		min-height: calc(100vh - 3.25rem);
		padding: 0 1.5rem 8rem;
		position: relative;
		display: flex;
		align-items: center;
		background: #d2e5ef;
		overflow: hidden;
	}

	.wave {
		position: absolute;
		bottom: -1px;
		left: 0;
		width: 100%;
		height: 200px;
		display: block;
	}

	.container {
		position: relative;
	}

	/* Staggered entrance */
	.greeting {
		animation: fadeUp 0.6s var(--ease-out) both;
		animation-delay: 0.05s;
	}
	h1 {
		animation: fadeUp 0.7s var(--ease-out) both;
		animation-delay: 0.15s;
	}
	.bio {
		animation: fadeUp 0.7s var(--ease-out) both;
		animation-delay: 0.28s;
	}

	.greeting {
		display: block;
		font-family: var(--font-mono);
		font-size: 0.8125rem;
		color: var(--color-accent);
		margin-bottom: 1rem;
		letter-spacing: 0.01em;
	}

	h1 {
		margin-bottom: 1.25rem;
		letter-spacing: -0.02em;
	}

	.bio {
		max-width: 520px;
		color: var(--color-text-muted);
		font-size: 1.0625rem;
		margin-bottom: 0;
		line-height: 1.75;
	}

	@media (max-width: 600px) {
		.hero {
			padding: 0 1.25rem 6rem;
		}
	}
</style>

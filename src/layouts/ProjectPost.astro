---
import type { CollectionEntry } from 'astro:content';
import BaseHead from '../components/BaseHead.astro';
import Nav from '../components/Nav.astro';
import Footer from '../components/Footer.astro';

type Props = CollectionEntry<'projects'>['data'] & { id: string };

const { title, description, stack, repo, live } = Astro.props;
---

<html lang="en">
	<head>
		<BaseHead title={`${title} — Joel Moffatt`} description={description} />
	</head>
	<body>
		<Nav />
		<main>
			<header class="project-header">
				<div class="container">
					<a href="/#projects" class="back">
						<svg viewBox="0 0 16 16" aria-hidden="true" width="12" height="12">
							<path fill="currentColor" d="M15 8a.5.5 0 0 0-.5-.5H2.707l3.147-3.146a.5.5 0 1 0-.708-.708l-4 4a.5.5 0 0 0 0 .708l4 4a.5.5 0 0 0 .708-.708L2.707 8.5H14.5A.5.5 0 0 0 15 8z"/>
						</svg>
						All projects
					</a>
					<span class="section-label">// project</span>
					<h1>{title}</h1>
					<p class="description">{description}</p>
					<ul class="stack">
						{stack.map((tech) => <li>{tech}</li>)}
					</ul>
					<div class="links">
						{repo && (
							<a href={repo} target="_blank" rel="noopener noreferrer" class="link-btn">
								<svg viewBox="0 0 16 16" aria-hidden="true" width="14" height="14">
									<path fill="currentColor" d="M8 0C3.58 0 0 3.58 0 8c0 3.54 2.29 6.53 5.47 7.59.4.07.55-.17.55-.38 0-.19-.01-.82-.01-1.49-2.01.37-2.53-.49-2.69-.94-.09-.23-.48-.94-.82-1.13-.28-.15-.68-.52-.01-.53.63-.01 1.08.58 1.23.82.72 1.21 1.87.87 2.33.66.07-.52.28-.87.51-1.07-1.78-.2-3.64-.89-3.64-3.95 0-.87.31-1.59.82-2.15-.08-.2-.36-1.02.08-2.12 0 0 .67-.21 2.2.82.64-.18 1.32-.27 2-.27.68 0 1.36.09 2 .27 1.53-1.04 2.2-.82 2.2-.82.44 1.1.16 1.92.08 2.12.51.56.82 1.27.82 2.15 0 3.07-1.87 3.75-3.65 3.95.29.25.54.73.54 1.48 0 1.07-.01 1.93-.01 2.2 0 .21.15.46.55.38A8.012 8.012 0 0 0 16 8c0-4.42-3.58-8-8-8z"/>
								</svg>
								Source code
							</a>
						)}
						{live && (
							<a href={live} target="_blank" rel="noopener noreferrer" class="link-btn link-btn--primary">
								<svg viewBox="0 0 16 16" aria-hidden="true" width="14" height="14">
									<path fill="currentColor" d="M8.636 3.5a.5.5 0 0 0-.5-.5H1.5A1.5 1.5 0 0 0 0 4.5v10A1.5 1.5 0 0 0 1.5 16h10a1.5 1.5 0 0 0 1.5-1.5V7.864a.5.5 0 0 0-1 0V14.5a.5.5 0 0 1-.5.5h-10a.5.5 0 0 1-.5-.5v-10a.5.5 0 0 1 .5-.5h6.636a.5.5 0 0 0 .5-.5z"/>
									<path fill="currentColor" d="M16 .5a.5.5 0 0 0-.5-.5h-5a.5.5 0 0 0 0 1h3.793L6.146 9.146a.5.5 0 1 0 .708.708L15 1.707V5.5a.5.5 0 0 0 1 0v-5z"/>
								</svg>
								Live site
							</a>
						)}
					</div>
				</div>
			</header>

			<div class="prose-wrapper">
				<div class="container">
					<article class="prose">
						<slot />
					</article>
				</div>
			</div>
		</main>
		<Footer />
	</body>
</html>

<style>
	.project-header {
		padding: 5rem 1.5rem 3.5rem;
		border-bottom: 1px solid var(--color-border);
	}

	.back {
		display: inline-flex;
		align-items: center;
		gap: 0.4rem;
		font-family: var(--font-mono);
		font-size: 0.72rem;
		color: var(--color-text-subtle);
		text-decoration: none;
		margin-bottom: 2rem;
		transition: color 0.15s ease;
	}

	.back:hover {
		color: var(--color-accent);
		text-decoration: none;
	}

	h1 {
		margin-bottom: 0.75rem;
	}

	.description {
		font-size: 1.0625rem;
		color: var(--color-text-muted);
		max-width: 560px;
		margin-bottom: 1.5rem;
		line-height: 1.7;
	}

	.stack {
		list-style: none;
		margin: 0 0 1.75rem;
		padding: 0;
		display: flex;
		flex-wrap: wrap;
		gap: 0.375rem;
	}

	.stack li {
		font-family: var(--font-mono);
		font-size: 0.7rem;
		color: var(--color-text-muted);
		background: var(--color-surface);
		border: 1px solid var(--color-border);
		border-radius: 3px;
		padding: 0.2rem 0.55rem;
	}

	.links {
		display: flex;
		gap: 0.6rem;
		flex-wrap: wrap;
	}

	.link-btn {
		display: inline-flex;
		align-items: center;
		gap: 0.45rem;
		font-family: var(--font-body);
		font-size: 0.875rem;
		font-weight: 500;
		padding: 0.5rem 1.1rem;
		border-radius: var(--radius);
		border: 1.5px solid var(--color-border);
		background: var(--color-surface);
		color: var(--color-text);
		text-decoration: none;
		transition: border-color 0.15s ease, color 0.15s ease;
	}

	.link-btn:hover {
		border-color: var(--color-border-strong);
		text-decoration: none;
	}

	.link-btn--primary {
		background: var(--color-accent);
		border-color: var(--color-accent);
		color: #fff;
	}

	.link-btn--primary:hover {
		background: var(--color-accent-hover);
		border-color: var(--color-accent-hover);
	}

	/* Prose */
	.prose-wrapper {
		padding: 4rem 1.5rem 6rem;
	}

	.prose {
		max-width: 680px;
	}

	.prose :global(h2) {
		font-size: 1.4rem;
		margin-top: 2.5rem;
		margin-bottom: 0.75rem;
		padding-bottom: 0.5rem;
		border-bottom: 1px solid var(--color-border);
	}

	.prose :global(h3) {
		font-size: 1.1rem;
		margin-top: 1.75rem;
		margin-bottom: 0.5rem;
	}

	.prose :global(p) {
		color: var(--color-text-muted);
		line-height: 1.8;
		margin-bottom: 1.25rem;
	}

	.prose :global(ul),
	.prose :global(ol) {
		color: var(--color-text-muted);
		padding-left: 1.25rem;
		margin-bottom: 1.25rem;
		line-height: 1.8;
	}

	.prose :global(li) {
		margin-bottom: 0.35rem;
	}

	.prose :global(code) {
		font-family: var(--font-mono);
		font-size: 0.85em;
		background: var(--color-surface);
		border: 1px solid var(--color-border);
		border-radius: 3px;
		padding: 0.1em 0.4em;
		color: var(--color-accent);
	}

	.prose :global(pre) {
		background: var(--color-surface);
		border: 1px solid var(--color-border);
		border-radius: var(--radius);
		padding: 1.25rem 1.5rem;
		overflow-x: auto;
		margin-bottom: 1.5rem;
	}

	.prose :global(pre code) {
		background: none;
		border: none;
		padding: 0;
		color: var(--color-text);
		font-size: 0.875rem;
	}

	.prose :global(a) {
		color: var(--color-accent);
		text-decoration: underline;
		text-underline-offset: 2px;
	}

	.prose :global(blockquote) {
		border-left: 3px solid var(--color-accent);
		margin-left: 0;
		padding-left: 1.25rem;
		color: var(--color-text-muted);
		font-style: italic;
	}
</style>
